{
  "manifest_version": 3,
  "name": "Warmer By .xampai",
  "version": "2.0.2",
  "description": "Warmer AdsPower · cookies · FR/UK. Auto-start si runner actif.",
  "action": {
    "default_title": "Warmer By .xampai",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "sw.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["logger/inject.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "world": "MAIN"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["logger/content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "world": "ISOLATED"
    }
  ],
  "permissions": [
    "cookies",
    "storage",
    "unlimitedStorage",
    "tabs",
    "scripting",
    "alarms",
    "webRequest",
    "webNavigation"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "http://127.0.0.1:3847/*"
  ],
  "incognito": "split"
}
